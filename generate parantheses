#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void backtrack(char **ans, int *returnSize, char *curr, int pos, int open, int close, int n) {
    if (pos == 2 * n) {
        curr[pos] = '\0';
        ans[*returnSize] = (char *)malloc((2 * n + 1) * sizeof(char));
        strcpy(ans[*returnSize], curr);
        (*returnSize)++;
        return;
    }

    if (open < n) {
        curr[pos] = '(';
        backtrack(ans, returnSize, curr, pos + 1, open + 1, close, n);
    }

    if (close < open) {
        curr[pos] = ')';
        backtrack(ans, returnSize, curr, pos + 1, open, close + 1, n);
    }
}

char** generateParenthesis(int n, int* returnSize) {
    char **ans = (char **)malloc(1500 * sizeof(char *)); // Enough for n <= 8
    char *curr = (char *)malloc((2 * n + 1) * sizeof(char));

    *returnSize = 0;
    backtrack(ans, returnSize, curr, 0, 0, 0, n);

    free(curr);
    return ans;
}
