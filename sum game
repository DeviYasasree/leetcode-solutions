class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int half = n / 2;

        int sumL = 0, sumR = 0;
        int cntL = 0, cntR = 0;

        for (int i = 0; i < half; i++) {
            char c = num.charAt(i);
            if (c == '?')
                cntL++;
            else
                sumL += c - '0';
        }

        for (int i = half; i < n; i++) {
            char c = num.charAt(i);
            if (c == '?')
                cntR++;
            else
                sumR += c - '0';
        }

        // Alice gets one extra move
        if (((cntL + cntR) & 1) == 1)
            return true;

        int diff = sumL - sumR;

        return diff != (cntR - cntL) / 2 * 9;
    }
}
