#include <string.h>

char* intToRoman(int num) {

    static char ans[20];

    ans[0] = '\0';

    int values[] = {
        1000,900,500,400,
        100,90,50,40,
        10,9,5,4,1
    };

    char *roman[] = {
        "M","CM","D","CD",
        "C","XC","L","XL",
        "X","IX","V","IV","I"
    };

    for(int i=0;i<13;i++)
    {
        while(num >= values[i])
        {
            strcat(ans, roman[i]);
            num -= values[i];
        }
    }

    return ans;
}
